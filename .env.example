# ==============================================
# CityPulse AI - Environment Variables Example
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit .env to git!
# ==============================================

# PostgreSQL Connection String
# Local (macOS Homebrew):
DATABASE_URL=Host=localhost;Database=citypulse;Username=your_username;SSL Mode=Prefer;Trust Server Certificate=true

# Docker Compose (use this when running with docker-compose):
# DATABASE_URL=Host=db;Database=citypulse;Username=citypulse_user;Password=your_password;SSL Mode=Disable

# Groq API Key (get yours at https://console.groq.com)
GEMINI_API_KEY=your_groq_api_key_here
